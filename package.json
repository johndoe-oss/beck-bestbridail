{
  "name": "beckbest-bridal",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --names \"api,web,sandbox\" --prefix-colors \"blue,green,magenta\" --restart-after 500 \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:sandbox\"",
    "dev:api": "cd artifacts/api-server && cross-env NODE_ENV=development PORT=5000 node --env-file-if-exists=../../.env --import tsx --enable-source-maps ./src/index.ts",
    "dev:api:build": "cd artifacts/api-server && node ./build.mjs && cross-env NODE_ENV=development PORT=5000 node --env-file-if-exists=../../.env --enable-source-maps ./dist/index.mjs",
    "dev:web": "cd artifacts/beckbest-bridal && cross-env PORT=5173 BASE_PATH=/ API_PROXY_TARGET=http://localhost:5000 vite --config vite.config.ts --host 0.0.0.0",
    "dev:sandbox": "cd artifacts/mockup-sandbox && cross-env PORT=5174 BASE_PATH=/ vite dev",
    "start": "node --enable-source-maps artifacts/api-server/dist/index.mjs",
    "build": "npm run build:api && npm run build:web",
    "build:api": "cd artifacts/api-server && node ./build.mjs",
    "build:web": "cd artifacts/beckbest-bridal && cross-env PORT=5173 BASE_PATH=/ vite build --config vite.config.ts",
    "build:sandbox": "cd artifacts/mockup-sandbox && cross-env PORT=5174 BASE_PATH=/ vite build",
    "seed": "cd artifacts/api-server && node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck:api && npm run typecheck:web && npm run typecheck:sandbox && npm run typecheck:scripts",
    "typecheck:api": "cd artifacts/api-server && tsc -p tsconfig.json --noEmit",
    "typecheck:web": "cd artifacts/beckbest-bridal && tsc -p tsconfig.json --noEmit",
    "typecheck:sandbox": "cd artifacts/mockup-sandbox && tsc -p tsconfig.json --noEmit",
    "typecheck:scripts": "cd scripts && tsc -p tsconfig.json --noEmit",
    "db:push": "cd lib/db && dotenv -e ../../.env -- drizzle-kit push --config ./drizzle.config.ts",
    "db:push-force": "cd lib/db && dotenv -e ../../.env -- drizzle-kit push --force --config ./drizzle.config.ts",
    "codegen": "orval --config ./lib/api-spec/orval.config.ts && npm run typecheck:libs",
    "scripts:hello": "cd scripts && tsx src/hello.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
